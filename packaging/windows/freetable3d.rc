// Ressources Windows : icône et informations de version intégrées à freetable3d.exe
// (Explorateur, barre des tâches, signature numérique).
// À mettre à jour à chaque nouvelle version (avec CMakeLists.txt et freetable3d.iss).
#include <winver.h>

1 ICON "freetable3d.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,5,0
PRODUCTVERSION  0,1,5,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName",      "KREUDER Olivier\0"
            VALUE "FileDescription",  "FreeTable3D - CAO libre pour l'impression 3D\0"
            VALUE "FileVersion",      "0.1.5\0"
            VALUE "InternalName",     "freetable3d\0"
            VALUE "LegalCopyright",   "Copyright (C) KREUDER Olivier - GPL v3\0"
            VALUE "OriginalFilename", "freetable3d.exe\0"
            VALUE "ProductName",      "FreeTable3D\0"
            VALUE "ProductVersion",   "0.1.5\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END
